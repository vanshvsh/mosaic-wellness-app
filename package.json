    "jsonwebtoken": "^9.1.2",
    "openai": "^4.67.3",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
