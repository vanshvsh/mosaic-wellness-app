{
  "name": "mosaic-wellness-app",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Full-stack wellness app with AI assistant, booking, and admin dashboard",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "cd client && npm run dev -- --host 0.0.0.0",
    "build": "cd client && npm run build",
    "start": "node server.js",
    "clean": "rm -rf node_modules client/node_modules && npm install && cd client && npm install && cd .."
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  },
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  }
}
